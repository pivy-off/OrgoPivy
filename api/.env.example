# OrgoPivy API — AI (pick one or both; DeepSeek is used first when set)

# Recommended: DeepSeek — sign up free at https://platform.deepseek.com
# New accounts receive free API credits (no credit card required for the grant).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional: force provider (auto | deepseek | gemini)
AI_PROVIDER=auto

# Fallback: Google Gemini
# GEMINI_API_KEY=

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
